{% assign lead = stories[0] %}
{% assign rail = stories[1] %}
{% assign lower_one = stories[2] %}
{% assign lower_two = stories[3] %}

<div class="bt" lang="en">
  <header class="bt-masthead">
    <div class="bt-masthead__side">No. {{ edition_id | slice: 0, 8 | escape }}</div>
    <h1 class="bt-masthead__name">The Berlin Times</h1>
    <div class="bt-masthead__side bt-masthead__side--right">{{ edition_name | escape }} edition</div>
  </header>

  <div class="bt-dateline">
    <span>{{ display_date | escape }}</span>
    <span>Four essential stories · English edition</span>
    <span>Next edition {{ next_scheduled_at | date: "%H:%M" }} Berlin</span>
  </div>

  <main class="bt-page">
    <div class="bt-left">
      <article class="bt-story bt-story--lead" data-story-id="{{ lead.id | escape }}">
        <p class="bt-kicker{% if lead.is_developing %} bt-kicker__developing{% endif %}">{{ lead.primary_category | replace: "_", " " | escape }}</p>
        <h2 class="bt-headline">{{ lead.headline | escape }}</h2>
        <div class="bt-lead__body">
          <figure class="bt-photo" data-photo-story-id="{{ lead_image.story_id | escape }}">
            <img class="image image--cover" src="{{ bt_lead_image_url | escape }}" alt="{{ lead_image.alt | escape }}">
            <figcaption class="bt-caption">Photograph: {{ lead_image.credit | escape }}</figcaption>
          </figure>
          <div class="bt-lead__copy">
            <p class="bt-summary">{{ lead.summary | escape }}</p>
            <p class="bt-byline">{{ lead.sources | map: "name" | join: " · " | escape }} · {{ lead.published_at | date: "%H:%M UTC" }}</p>
          </div>
        </div>
      </article>

      <div class="bt-lower">
        <article class="bt-story bt-story--brief" data-story-id="{{ lower_one.id | escape }}">
          <p class="bt-kicker{% if lower_one.is_developing %} bt-kicker__developing{% endif %}">{{ lower_one.primary_category | replace: "_", " " | escape }}</p>
          <h2 class="bt-headline">{{ lower_one.headline | escape }}</h2>
          <p class="bt-summary">{{ lower_one.summary | escape }}</p>
          <p class="bt-byline">{{ lower_one.sources | map: "name" | join: " · " | escape }} · {{ lower_one.published_at | date: "%H:%M UTC" }}</p>
        </article>

        <article class="bt-story bt-story--brief" data-story-id="{{ lower_two.id | escape }}">
          <p class="bt-kicker{% if lower_two.is_developing %} bt-kicker__developing{% endif %}">{{ lower_two.primary_category | replace: "_", " " | escape }}</p>
          <h2 class="bt-headline">{{ lower_two.headline | escape }}</h2>
          <p class="bt-summary">{{ lower_two.summary | escape }}</p>
          <p class="bt-byline">{{ lower_two.sources | map: "name" | join: " · " | escape }} · {{ lower_two.published_at | date: "%H:%M UTC" }}</p>
        </article>

      </div>
    </div>

    <article class="bt-story bt-story--rail" data-story-id="{{ rail.id | escape }}">
      <p class="bt-kicker{% if rail.is_developing %} bt-kicker__developing{% endif %}">{{ rail.primary_category | replace: "_", " " | escape }}</p>
      <h2 class="bt-headline">{{ rail.headline | escape }}</h2>
      <p class="bt-summary">{{ rail.summary | escape }}</p>
      <p class="bt-byline">{{ rail.sources | map: "name" | join: " · " | escape }} · {{ rail.published_at | date: "%H:%M UTC" }}</p>
    </article>
  </main>
</div>

<script>
  window.BERLIN_TIMES_LAYOUT_READY = false;
  void (async () => {
    await document.fonts.ready;
    if (document.readyState !== "complete") {
      await new Promise((resolve) => window.addEventListener("load", resolve, { once: true }));
    }
    await new Promise((resolve) => requestAnimationFrame(resolve));
    await new Promise((resolve) => requestAnimationFrame(resolve));
    const deadline = Date.now() + 5000;
    while (Date.now() < deadline) {
      const scheduler = window.__terminalizeScheduler;
      if (window.TRMNL_PLUGINS_READY !== false && !scheduler?.pending && !scheduler?.inFlight) {
        break;
      }
      await new Promise((resolve) => window.setTimeout(resolve, 25));
    }
    await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
    window.scrollTo(0, 0);
    window.BERLIN_TIMES_LAYOUT_READY = true;
  })();
</script>
