{% assign lead = stories[0] %}
{% assign secondary_one = stories[1] %}
{% assign secondary_two = stories[2] %}
{% assign rail_one = stories[3] %}
{% assign rail_two = stories[4] %}
{% assign rail_three = stories[5] %}
{% assign photo_story = stories | where: "id", lead_image.story_id | first %}

<div class="layout layout--col bt">
  <header class="bt-masthead">
    <div class="bt-masthead__side">No. {{ edition_id | slice: 0, 8 | escape }}</div>
    <h1 class="bt-masthead__name">Berlin Times</h1>
    <div class="bt-masthead__side bt-masthead__side--right">{{ edition_name | escape }} edition</div>
  </header>

  <div class="bt-dateline">
    <span>{{ display_date | escape }}</span>
    <span>Six essential stories · English edition</span>
    <span>Next edition {{ next_scheduled_at | date: "%H:%M" }} Berlin</span>
  </div>

  <div class="bt-page">
    <main class="bt-main">
      <article class="bt-feature bt-story" data-story-id="{{ lead.id | escape }}">
        <div class="bt-feature__copy">
          <p class="bt-kicker{% if lead.is_developing %} bt-kicker__developing{% endif %}">{{ lead.primary_category | replace: "_", " " | escape }}</p>
          <h2 class="bt-headline">{{ lead.headline | escape }}</h2>
          <p class="bt-summary">{{ lead.summary | escape }}</p>
          <p class="bt-byline">{{ lead.sources | map: "name" | join: " · " | escape }} · {{ lead.published_at | date: "%H:%M UTC" }}</p>
        </div>

        <figure class="bt-photo">
          <img class="image image-dither image--cover" src="{{ bt_lead_image_url | escape }}" alt="{{ lead_image.alt | escape }}">
          <figcaption class="bt-caption">Photograph: {{ lead_image.credit | escape }}{% if photo_story.id != lead.id %} · {{ photo_story.headline | escape }}{% endif %}</figcaption>
        </figure>
      </article>

      <section class="bt-secondary">
        <article class="bt-story" data-story-id="{{ secondary_one.id | escape }}">
          <p class="bt-kicker{% if secondary_one.is_developing %} bt-kicker__developing{% endif %}">{{ secondary_one.primary_category | replace: "_", " " | escape }}</p>
          <h2 class="bt-headline">{{ secondary_one.headline | escape }}</h2>
          <p class="bt-summary">{{ secondary_one.summary | escape }}</p>
          <p class="bt-byline">{{ secondary_one.sources | map: "name" | join: " · " | escape }} · {{ secondary_one.published_at | date: "%H:%M UTC" }}</p>
        </article>

        <article class="bt-story" data-story-id="{{ secondary_two.id | escape }}">
          <p class="bt-kicker{% if secondary_two.is_developing %} bt-kicker__developing{% endif %}">{{ secondary_two.primary_category | replace: "_", " " | escape }}</p>
          <h2 class="bt-headline">{{ secondary_two.headline | escape }}</h2>
          <p class="bt-summary">{{ secondary_two.summary | escape }}</p>
          <p class="bt-byline">{{ secondary_two.sources | map: "name" | join: " · " | escape }} · {{ secondary_two.published_at | date: "%H:%M UTC" }}</p>
        </article>
      </section>
    </main>

    <aside class="bt-rail">
      <article class="bt-story" data-story-id="{{ rail_one.id | escape }}">
        <p class="bt-kicker{% if rail_one.is_developing %} bt-kicker__developing{% endif %}">{{ rail_one.primary_category | replace: "_", " " | escape }}</p>
        <h2 class="bt-headline">{{ rail_one.headline | escape }}</h2>
        <p class="bt-summary">{{ rail_one.summary | escape }}</p>
        <p class="bt-byline">{{ rail_one.sources | map: "name" | join: " · " | escape }} · {{ rail_one.published_at | date: "%H:%M UTC" }}</p>
      </article>

      <article class="bt-story" data-story-id="{{ rail_two.id | escape }}">
        <p class="bt-kicker{% if rail_two.is_developing %} bt-kicker__developing{% endif %}">{{ rail_two.primary_category | replace: "_", " " | escape }}</p>
        <h2 class="bt-headline">{{ rail_two.headline | escape }}</h2>
        <p class="bt-summary">{{ rail_two.summary | escape }}</p>
        <p class="bt-byline">{{ rail_two.sources | map: "name" | join: " · " | escape }} · {{ rail_two.published_at | date: "%H:%M UTC" }}</p>
      </article>

      <article class="bt-story" data-story-id="{{ rail_three.id | escape }}">
        <p class="bt-kicker{% if rail_three.is_developing %} bt-kicker__developing{% endif %}">{{ rail_three.primary_category | replace: "_", " " | escape }}</p>
        <h2 class="bt-headline">{{ rail_three.headline | escape }}</h2>
        <p class="bt-summary">{{ rail_three.summary | escape }}</p>
        <p class="bt-byline">{{ rail_three.sources | map: "name" | join: " · " | escape }} · {{ rail_three.published_at | date: "%H:%M UTC" }}</p>
      </article>
    </aside>
  </div>
</div>

<script>
  window.BERLIN_TIMES_LAYOUT_READY = false;
  void (async () => {
    await document.fonts.ready;
    if (window.terminalize) {
      await window.terminalize();
    }
    window.scrollTo(0, 0);
    window.BERLIN_TIMES_LAYOUT_READY = true;
  })();
</script>
