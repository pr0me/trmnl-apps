{% assign bt_stylesheet_url = stylesheet_url %}
{% if bt_stylesheet_url == blank %}
  {% assign bt_lead_image_name = lead_image.url | split: "/" | last %}
  {% assign bt_stylesheet_url = lead_image.url | replace: bt_lead_image_name, "berlin-times.css" %}
{% endif %}
{% assign bt_fraktur_url = bt_stylesheet_url | replace: "berlin-times.css", "fonts/UnifrakturCook-Bold.ttf" %}
{% assign bt_serif_url = bt_stylesheet_url | replace: "berlin-times.css", "fonts/SourceSerif4-Variable.ttf" %}
{% assign bt_lead_image_url = lead_image.url %}
{% if stylesheet_url %}
  {% assign bt_asset_base_url = bt_stylesheet_url | replace: "berlin-times.css", "" %}
  {% assign bt_lead_image_name = lead_image.url | split: "/" | last %}
  {% assign bt_lead_image_url = bt_asset_base_url | append: bt_lead_image_name %}
{% endif %}
<link rel="stylesheet" href="{{ bt_stylesheet_url | escape }}">
<link rel="preload" href="{{ bt_fraktur_url | escape }}" as="font" type="font/ttf" crossorigin>
<link rel="preload" href="{{ bt_serif_url | escape }}" as="font" type="font/ttf" crossorigin>
{% if bt_lead_image_url %}<link rel="preload" href="{{ bt_lead_image_url | escape }}" as="image" crossorigin>{% endif %}
