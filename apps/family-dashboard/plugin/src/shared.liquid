      </g>
      <path d="M29 95c-13 0-21-8-21-19 0-12 9-20 22-20 5-14 16-23 31-23 19 0 33 14 34 33 10 1 17 8 17 17 0 8-7 12-16 12H29Z" fill="var(--fd-paper)" stroke="currentColor" stroke-linejoin="round" stroke-width="8"/>
    </symbol>
    <symbol id="fd-glyph-rain" viewBox="0 0 120 120">
      <path d="M28 72C15 72 7 64 7 53c0-12 9-20 22-20C34 19 46 10 61 10c19 0 34 14 35 33 10 2 17 9 17 18 0 7-7 11-16 11H28Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="8"/>
      <g stroke="currentColor" stroke-linecap="square" stroke-width="8">
        <path d="M33 85l-8 22M65 85l-8 22M97 85l-8 22"/>
      </g>
    </symbol>
    <symbol id="fd-glyph-snow" viewBox="0 0 120 120">
      <path d="M28 66C15 66 7 58 7 47c0-12 9-20 22-20C34 13 46 4 61 4c19 0 34 14 35 33 10 2 17 9 17 18 0 7-7 11-16 11H28Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="8"/>
      <g fill="none" stroke="currentColor" stroke-width="5">
        <line x1="21" y1="82" x2="49" y2="106"/><line x1="49" y1="82" x2="21" y2="106"/>
        <line x1="70" y1="82" x2="98" y2="106"/><line x1="98" y1="82" x2="70" y2="106"/>
      </g>
    </symbol>
  </defs>
</svg>
