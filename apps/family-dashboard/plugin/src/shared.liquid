<style>
  .screen:has(.fd) {
    width: 1872px;
    height: 1404px;
  }

  .screen.screen--v2:has(.fd) {
    width: 1040px;
    height: 780px;
  }

  .screen--v2:has(.fd) .fd {
    width: 1872px;
    height: 1404px;
    flex: none;
    zoom: .541310541;
  }

  @media (width: 1040px) and (height: 780px) {
    .screen:has(.fd) {
      width: 1040px;
      height: 780px;
    }

    .screen:has(.fd) .fd {
      width: 1872px;
      height: 1404px;
      flex: none;
      zoom: .541310541;
    }
  }

  .view:has(.fd) {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .fd {
    --fd-ink: #0b0b0b;
    --fd-mid: #676767;
    --fd-soft: #d0d0d0;
    --fd-paper: #fff;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) 32px;
    overflow: hidden;
    color: var(--fd-ink);
    background: var(--fd-paper);
    font-family: "TRMNL", sans-serif;
  }

  .fd * {
    --fd-fs: inherit;
    --fd-jc: normal;
    --fd-mg: 0;
    --fd-pad: 0;
    --fd-ta: start;
    box-sizing: border-box;
    justify-content: var(--fd-jc);
    margin: var(--fd-mg);
    padding: var(--fd-pad);
    font-size: var(--fd-fs);
    text-align: var(--fd-ta);
  }

  .fd-symbols {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .fd-board {
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 54fr) 4px minmax(0, 46fr);
    --fd-pad: 22px 24px 0;
  }

  .fd-divider {
    background: var(--fd-ink);
  }

  .fd-weather,
  .fd-right,
  .fd-today,
  .fd-forecast,
  .fd-events,
  .fd-transit {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .fd-weather {
    display: grid;
    grid-template-rows: minmax(0, 1fr) minmax(0, 2fr);
    --fd-pad: 0 24px 0 0;
  }

  .fd-right {
    display: grid;
    grid-template-rows: minmax(0, 58fr) 4px minmax(0, 42fr);
    --fd-pad: 0 0 0 24px;
  }

  .fd-rule {
    background: var(--fd-ink);
  }

  .fd-section-heading,
  .fd-today__date,
  .fd-direction__heading,
  .fd-empty {
    text-transform: uppercase;
    letter-spacing: .075em;
  }

  .fd-section-heading {
    height: 54px;
    display: flex;
    align-items: center;
    --fd-jc: space-between;
    --fd-pad: 0 15px;
    color: var(--fd-paper);
    background: var(--fd-ink);
    --fd-fs: 22px;
    font-weight: 800;
    line-height: 1;
  }

  .fd-section-heading__minor {
    --fd-fs: 16px;
    font-weight: 650;
    letter-spacing: .09em;
  }

  .fd-today {
    display: grid;
    grid-template-rows: 54px minmax(0, 1fr);
    border-bottom: 4px solid var(--fd-ink);
  }

  .fd-today__body {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 43fr) minmax(0, 57fr);
    align-items: center;
    --fd-pad: 8px 18px 9px 8px;
  }

  .fd-today__glyph {
    width: 100%;
    height: 100%;
    max-height: 330px;
    color: var(--fd-ink);
  }

  .fd-today__reading {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    align-items: center;
  }

  .fd-current {
    --fd-fs: 176px;
    font-weight: 850;
    line-height: .82;
    letter-spacing: -.085em;
    white-space: nowrap;
  }

  .fd-current__degree {
    --fd-fs: .48em;
    --fd-mg: 0 0 0 5px;
    vertical-align: top;
  }

  .fd-current__condition {
    --fd-fs: 31px;
    --fd-mg: 18px 0 0;
    font-weight: 750;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .fd-metrics {
    display: grid;
    gap: 18px;
    --fd-pad: 0 0 0 24px;
    border-left: 2px solid var(--fd-soft);
  }

  .fd-metric {
    display: grid;
    gap: 3px;
  }

  .fd-metric__value {
    --fd-fs: 47px;
    font-weight: 800;
    line-height: 1;
  }

  .fd-metric__label {
    color: var(--fd-mid);
    --fd-fs: 16px;
    font-weight: 750;
    line-height: 1;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .fd-forecast {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .fd-forecast > .fd-empty {
    grid-column: 1 / -1;
  }

  .fd-day {
    min-width: 0;
    display: grid;
    grid-template-rows: 66px minmax(0, 1fr) auto auto;
    justify-items: center;
    --fd-pad: 18px 16px 38px;
    border-right: 2px solid var(--fd-soft);
  }

  .fd-day:last-child {
    border-right: 0;
  }

  .fd-day__heading {
    width: 100%;
    display: flex;
    align-items: baseline;
    --fd-jc: space-between;
    border-bottom: 2px solid var(--fd-ink);
    --fd-fs: 25px;
    font-weight: 850;
    text-transform: uppercase;
  }

  .fd-day__date {
    color: var(--fd-mid);
    --fd-fs: 17px;
    font-weight: 700;
  }

  .fd-day__glyph {
    width: 92%;
    height: 92%;
    max-height: 390px;
    align-self: center;
    color: var(--fd-ink);
  }

  .fd-day__condition {
    --fd-mg: 0 0 14px;
    color: var(--fd-mid);
    --fd-fs: 22px;
    font-weight: 700;
  }

  .fd-day__maximum {
    --fd-fs: 83px;
    font-weight: 850;
    line-height: .9;
    letter-spacing: -.055em;
  }

  .fd-events {
    display: grid;
    grid-template-rows: 54px minmax(0, 1fr);
    --fd-pad: 0 0 20px;
  }

  .fd-event-list {
    min-height: 0;
    display: grid;
    grid-template-rows: repeat(5, minmax(0, 1fr));
  }

  .fd-event {
    min-width: 0;
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr) 112px;
    align-items: center;
    gap: 15px;
    border-bottom: 2px solid var(--fd-soft);
  }

  .fd-event:last-child {
    border-bottom: 0;
  }

  .fd-event__date {
    display: grid;
    align-content: center;
    align-self: stretch;
    justify-items: center;
    color: var(--fd-paper);
    background: var(--fd-ink);
  }

  .fd-event__weekday {
    --fd-fs: 25px;
    font-weight: 850;
    line-height: 1;
    text-transform: uppercase;
  }

  .fd-event__day {
    --fd-fs: 16px;
    --fd-mg: 5px 0 0;
    font-weight: 650;
    line-height: 1;
  }

  .fd-event__title {
    display: -webkit-box;
    --fd-mg: 0;
    overflow: hidden;
    --fd-fs: 32px;
    font-weight: 760;
    line-height: 1.03;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .fd-event__time {
    --fd-fs: 25px;
    --fd-pad: 0 10px 0 0;
    font-weight: 800;
    line-height: 1;
    --fd-ta: right;
    white-space: nowrap;
  }

  .fd-event__time--all-day {
    --fd-fs: 16px;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .fd-transit {
    display: grid;
    grid-template-rows: 54px minmax(0, 1fr);
    --fd-pad: 20px 0 0;
  }

  .fd-transit__body {
    min-height: 0;
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .fd-direction {
    min-height: 0;
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    border-bottom: 2px solid var(--fd-soft);
  }

  .fd-direction:last-child {
    border-bottom: 0;
  }

  .fd-direction__heading {
    display: flex;
    align-items: center;
    --fd-jc: center;
    overflow: hidden;
    --fd-pad: 0 13px;
    border-right: 2px solid var(--fd-soft);
    --fd-fs: 16px;
    font-weight: 850;
    letter-spacing: .04em;
    line-height: 1.06;
    --fd-ta: center;
  }

  .fd-departures {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .fd-departure {
    min-width: 0;
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    align-content: center;
    column-gap: 10px;
    --fd-pad: 9px 12px;
    border-right: 2px solid var(--fd-soft);
  }

  .fd-departure:last-child {
    border-right: 0;
  }

  .fd-departure__line {
    grid-row: 1 / 3;
    align-self: center;
    display: flex;
    align-items: center;
    --fd-jc: center;
    width: 58px;
    height: 58px;
    color: var(--fd-paper);
    background: var(--fd-ink);
    --fd-fs: 23px;
    font-weight: 900;
    line-height: 1;
  }

  .fd-departure__destination {
    align-self: end;
    overflow: hidden;
    --fd-fs: 17px;
    font-weight: 720;
    line-height: 1.05;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .fd-departure__delay {
    align-self: start;
    color: var(--fd-mid);
    --fd-fs: 14px;
    font-weight: 750;
    line-height: 1;
  }

  .fd-departure__time {
    grid-column: 3;
    grid-row: 1 / 3;
    align-self: center;
    --fd-fs: 34px;
    --fd-pad: 0 0 0 4px;
    font-weight: 850;
    line-height: 1;
  }

  .fd-empty {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    --fd-jc: center;
    --fd-pad: 24px;
    color: var(--fd-mid);
    --fd-fs: 20px;
    font-weight: 750;
    line-height: 1.25;
    --fd-ta: center;
  }

  .fd-footer {
    display: flex;
    align-items: center;
    --fd-jc: space-between;
    --fd-pad: 0 25px;
    color: var(--fd-mid);
    border-top: 1px solid var(--fd-soft);
    --fd-fs: 13px;
    font-weight: 650;
    line-height: 1;
    letter-spacing: .055em;
    text-transform: uppercase;
  }

  .fd-notice {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    --fd-jc: center;
    --fd-pad: 24px;
    border: 2px solid #000;
    --fd-fs: 20px;
    font-weight: 650;
    line-height: 1.35;
    --fd-ta: center;
  }
</style>

<svg class="fd-symbols" aria-hidden="true">
  <defs>
    <symbol id="fd-glyph-sun" viewBox="0 0 120 120">
      <circle cx="60" cy="60" r="25" fill="none" stroke="currentColor" stroke-width="8"/>
      <g fill="none" stroke="currentColor" stroke-linecap="square" stroke-width="8">
