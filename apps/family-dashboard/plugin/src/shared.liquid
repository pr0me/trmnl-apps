    </symbol>
    <symbol id="fd-glyph-partly-cloudy" viewBox="0 0 120 120">
      <circle cx="39" cy="38" r="20" fill="none" stroke="currentColor" stroke-width="7"/>
      <g fill="none" stroke="currentColor" stroke-width="7">
