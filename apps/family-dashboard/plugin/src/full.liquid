{% assign helper_present = true %}
{% if dashboard_data_source == blank %}
  {% assign helper_present = false %}
{% endif %}
{% assign helper_data = dashboard_data_source.merge_variables | default: dashboard_data_source %}
{% if helper_data.data.contract == "family_dashboard_data_v1" %}
  {% assign helper_data = helper_data.data %}
{% endif %}
{% assign helper_valid = false %}
{% if helper_present and helper_data.contract == "family_dashboard_data_v1" %}
  {% assign helper_valid = true %}
{% endif %}
{% assign weather = helper_data.weather %}
{% assign labels = helper_data.labels %}
{% assign departures = helper_data.departures %}
{% assign source_status = helper_data.source_status %}
{% assign generated_time = helper_data.generated_time %}
{% assign calendar_label = trmnl.plugin_settings.custom_fields_values.calendar_label %}
{% assign calendar_present = true %}
{% if calendar_source == blank %}
  {% assign calendar_present = false %}
{% endif %}
{% assign events = calendar_source.events %}
{% if events == blank and calendar_source.data.events != blank %}
  {% assign events = calendar_source.data.events %}
{% endif %}

<div class="fd">
  <main class="fd-board">
    <section class="fd-weather">
      <div class="fd-today">
        <div class="fd-section-heading">
          <span>Heute</span>
          {% if helper_valid and source_status.weather != "error" and weather.days.size > 0 %}<span class="fd-section-heading__minor">{{ weather.days[0].weekday }} · {{ weather.days[0].date_label }}</span>{% endif %}
        </div>
        {% unless helper_present %}
          <div class="fd-empty">Dashboard-Datenquelle fehlt</div>
        {% elsif helper_valid == false %}
          <div class="fd-empty">Falsche Dashboard-Datenquelle</div>
        {% elsif source_status.weather == "error" %}
          <div class="fd-empty">Wetter derzeit nicht verfügbar</div>
        {% elsif weather.days.size > 0 %}
          <div class="fd-today__body">
            <svg class="fd-today__glyph" role="img" aria-label="{{ weather.days[0].state_label | escape }}"><use href="#fd-glyph-{{ weather.days[0].glyph | escape }}"></use></svg>
            <div class="fd-today__reading">
              <div>
                <div class="fd-current">{{ weather.current_c }}<span class="fd-current__degree">°</span></div>
                <div class="fd-current__condition">{{ weather.days[0].state_label | escape }}</div>
              </div>
              <div class="fd-metrics">
                <div class="fd-metric">
                  <span class="fd-metric__value">{{ weather.humidity_pct }}%</span>
                  <span class="fd-metric__label">Luftfeuchte</span>
                </div>
                <div class="fd-metric">
                  <span class="fd-metric__value">{{ weather.days[0].max_c }}°</span>
                  <span class="fd-metric__label">Maximum</span>
                </div>
              </div>
            </div>
          </div>
        {% else %}
          <div class="fd-empty">Keine Wetterdaten</div>
        {% endunless %}
      </div>

      <div class="fd-forecast">
        {% if helper_valid and source_status.weather != "error" and weather.days.size > 0 %}
          {% for day in weather.days offset: 1 limit: 3 %}
            <article class="fd-day">
              <div class="fd-day__heading">
                <span>{{ day.weekday | escape }}</span>
                <span class="fd-day__date">{{ day.date_label | escape }}</span>
              </div>
              <svg class="fd-day__glyph" role="img" aria-label="{{ day.state_label | escape }}"><use href="#fd-glyph-{{ day.glyph | escape }}"></use></svg>
              <div class="fd-day__condition">{{ day.state_label | escape }}</div>
              <div class="fd-day__maximum">{{ day.max_c }}°</div>
            </article>
          {% endfor %}
        {% elsif helper_present == false %}
          <div class="fd-empty">Dashboard-Datenquelle fehlt</div>
        {% elsif helper_valid == false %}
          <div class="fd-empty">Falsche Dashboard-Datenquelle</div>
        {% elsif source_status.weather == "error" %}
          <div class="fd-empty">Keine Vorhersage</div>
        {% else %}
          <div class="fd-empty">Keine Wetterdaten</div>
        {% endif %}
      </div>
    </section>

    <div class="fd-divider"></div>

    <section class="fd-right">
      <section class="fd-events">
        <div class="fd-section-heading">
          <span>Nächste Termine</span>
          <span class="fd-section-heading__minor">{{ calendar_label | escape }}</span>
        </div>
        {% unless calendar_present %}
          <div class="fd-empty">Kalenderquelle fehlt</div>
        {% elsif events.size == 0 %}
          <div class="fd-empty">Keine anstehenden Termine</div>
        {% else %}
          <div class="fd-event-list">
            {% for event in events limit: 5 %}
              {% assign weekday_number = event.date_time | date: "%w" %}
              {% case weekday_number %}
                {% when "1" %}{% assign event_weekday = "Mo" %}
                {% when "2" %}{% assign event_weekday = "Di" %}
                {% when "3" %}{% assign event_weekday = "Mi" %}
                {% when "4" %}{% assign event_weekday = "Do" %}
                {% when "5" %}{% assign event_weekday = "Fr" %}
                {% when "6" %}{% assign event_weekday = "Sa" %}
                {% else %}{% assign event_weekday = "So" %}
              {% endcase %}
              <article class="fd-event">
                <div class="fd-event__date">
                  <span class="fd-event__weekday">{{ event_weekday }}</span>
                  <span class="fd-event__day">{{ event.date_time | date: "%-d.%m." }}</span>
                </div>
                <h2 class="fd-event__title">{{ event.summary | default: "Ohne Titel" | escape }}</h2>
                <time class="fd-event__time{% if event.all_day %} fd-event__time--all-day{% endif %}">{% if event.all_day %}ganztägig{% else %}{{ event.start | escape }}{% endif %}</time>
              </article>
            {% endfor %}
          </div>
        {% endunless %}
      </section>

      <div class="fd-rule"></div>

      <section class="fd-transit">
        <div class="fd-section-heading">
          <span>{% if helper_valid %}Ab {{ labels.stop | escape }}{% else %}Abfahrten{% endif %}</span>
          <span class="fd-section-heading__minor">Tram</span>
        </div>
        <div class="fd-transit__body">
          {% assign directions = "direction_a,direction_b" | split: "," %}
          {% for direction in directions %}
            {% if direction == "direction_a" %}
              {% assign direction_label = labels.direction_a %}
              {% assign direction_departures = departures.direction_a %}
              {% assign direction_status = source_status.direction_a %}
            {% else %}
              {% assign direction_label = labels.direction_b %}
              {% assign direction_departures = departures.direction_b %}
              {% assign direction_status = source_status.direction_b %}
            {% endif %}
            <div class="fd-direction" data-direction="{{ direction | escape }}">
              <div class="fd-direction__heading">
                {{ direction_label | default: "Datenquelle" | escape }}
              </div>
              {% unless helper_present %}
                <div class="fd-empty">Datenquelle fehlt</div>
              {% elsif helper_valid == false %}
                <div class="fd-empty">Falsche Datenquelle</div>
              {% elsif direction_status == "error" %}
                <div class="fd-empty">Derzeit nicht verfügbar</div>
              {% elsif direction_departures.size == 0 %}
                <div class="fd-empty">Keine Abfahrten</div>
              {% else %}
                <div class="fd-departures">
                  {% for departure in direction_departures limit: 2 %}
                    <article class="fd-departure">
                      <span class="fd-departure__line">{{ departure.line | escape }}</span>
                      <span class="fd-departure__destination">{{ departure.destination | escape }}</span>
                      <span class="fd-departure__delay">{{ departure.delay_label | escape }}</span>
                      <time class="fd-departure__time">{{ departure.time | escape }}</time>
                    </article>
                  {% endfor %}
                </div>
              {% endunless %}
            </div>
          {% endfor %}
        </div>
      </section>
    </section>
  </main>

  <footer class="fd-footer">
    <span>{% if helper_valid %}Stand {{ generated_time | escape }} · {% endif %}Wetter: Open-Meteo</span>
    <span>Verkehr: transport.rest / BVG</span>
  </footer>
</div>

<script>
  window.FAMILY_DASHBOARD_READY = false;
  void (async () => {
    await document.fonts.ready;
    await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
    window.scrollTo(0, 0);
    window.FAMILY_DASHBOARD_READY = true;
  })();
</script>
